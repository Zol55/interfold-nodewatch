# @interfold/sdk is listed as an optional dependency (see README > SDK usage).
# It pulls a heavy FHE toolchain (barretenberg wasm, noir) plus a git+ssh
# transitive dependency, which is unreliable in CI and sandboxed installs.
# This tool does not import it at runtime, so we skip installing it by
# default. Remove this line (or pass --include=optional) if you want it
# available locally for experimentation.
omit=optional
