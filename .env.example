# RPC endpoint used for all chain reads. Public endpoints work fine since
# nodewatch never sends transactions or needs a private key.
RPC_URL=https://ethereum-rpc.publicnode.com

# mainnet | sepolia
CHAIN=mainnet

# Your ciphernode operator address. Overridable per command with --operator.
OPERATOR_ADDRESS=0xYourOperatorAddress

# Optional: Telegram alerts for `nodewatch watch`. Leave unset to only log
# alerts to stdout. Create a bot with @BotFather, then message the bot once
# and fetch your chat id from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Poll interval for `nodewatch watch`, in seconds. Overridable with --interval.
POLL_INTERVAL=60

# Port for `nodewatch exporter`. Overridable with --port.
EXPORTER_PORT=9464

# How often `watch`/`exporter` check GitHub for a new interfold release, in
# minutes. Overridable with --release-check-interval.
RELEASE_CHECK_MINUTES=60
